{
  "name": "dairydrop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "DairyDrop — dairy delivery SaaS. Next.js App Router, JavaScript, role-based access control.",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "clean": "rm -rf .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.js",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/db/seed.js",
    "db:studio": "drizzle-kit studio",
    "jobs:close-month": "node src/jobs/run.js close-month",
    "jobs:deliveries": "node src/jobs/run.js generate-deliveries",
    "jobs:expire": "node src/jobs/run.js expire-subscriptions",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "node src/db/check.js",
    "db:setup": "npm run db:check && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "@tanstack/react-query": "^5.62.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.38.2",
    "next": "^15.1.3",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "dotenv": "^18.0.2",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
